# WhomeAI API Configuration
# Get your API key from: https://whomeai.com
WHOMEAI_API_KEY=sk-demo

# API Endpoint
VITE_WHOMEAI_API_ENDPOINT=https://api.whomeai.com/v1/images/generations

# ============================================
# STRIPE CONFIGURATION
# ============================================
# Get your Stripe keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Product Configuration
# Create a product in Stripe Dashboard and get the price ID
STRIPE_PRICE_ID=price_your_price_id

# Coupon for first month discount (37% off = $19 instead of $30)
# Create a coupon in Stripe Dashboard: 37% off, applies once per customer
STRIPE_FIRST_MONTH_COUPON_ID=firstmonth

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get your Supabase credentials from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT Secret (generate a random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production